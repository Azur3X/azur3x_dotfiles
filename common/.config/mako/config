# mako — Graphite
max-history=30
sort=-time

anchor=bottom-right
outer-margin=20
margin=12
padding=10,14
width=360

font=JetBrainsMono Nerd Font 10
border-size=2
border-radius=6

background-color=#1e1e1eee
text-color=#d5d4d0
border-color=#7daad1
progress-color=over #2a3744

icons=1
max-icon-size=24
max-visible=5
default-timeout=5000
ignore-timeout=0

[urgency=low]
text-color=#bfbeba
border-color=#262626
default-timeout=3000

[urgency=critical]
text-color=#ecebe7
border-color=#d0938d
default-timeout=0
