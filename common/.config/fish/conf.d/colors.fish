# ~/.config/fish/conf.d/colors.fish
# Uses ANSI names only, so fish follows whatever palette kitty sets.
set -g fish_color_normal          normal
set -g fish_color_command         blue
set -g fish_color_keyword         magenta
set -g fish_color_param           normal
set -g fish_color_option          cyan
set -g fish_color_quote           green
set -g fish_color_redirection     cyan
set -g fish_color_end             magenta
set -g fish_color_operator        yellow
set -g fish_color_escape          yellow
set -g fish_color_error           red
set -g fish_color_comment         brblack
set -g fish_color_autosuggestion  brblack
set -g fish_color_valid_path      --underline
set -g fish_color_search_match    --background=brblack
set -g fish_color_selection       --background=brblack
set -g fish_color_cancel          red
set -g fish_pager_color_prefix      blue --bold
set -g fish_pager_color_completion  normal
set -g fish_pager_color_description brblack
set -g fish_pager_color_progress    brblack
